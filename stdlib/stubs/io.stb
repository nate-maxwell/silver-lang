# Editor stub for import("io").
#
# print, println, and the stdin/stdout/stderr streams are the only functions that talk
# to the process's actual console; open and File work with arbitrary paths
# on disk. Every fallible operation returns one of the error structs below
# instead of raising, so callers pattern-match the result or catch it as a
# thrown value.

struct IOError {
    # IOError is the general-purpose I/O failure, covering closed streams and
    # operating-system errors other than a missing file or denied permission.
    message: str
}

struct FileNotFound {
    # FileNotFound is returned by open when path does not exist.
    message: str
}

struct PermissionDenied {
    # PermissionDenied is returned by open when the operating system refuses
    # access to path for a reason other than it being missing.
    message: str
}

struct IOStream {
    # IOStream wraps one of the process's standard streams. stdin only
    # supports read and read_line; stdout and stderr only support write. Calling
    # an unsupported operation returns an IOError rather than raising a type
    # error, since all three streams share this same struct shape.
    name: str
    read: call() str | IOError
    read_line: call() str | IOError
    write: call(data: str) | IOError
}

struct File {
    # File represents one already-open file handle returned by open. read
    # always rewinds to the beginning and returns the file's complete current
    # contents; write rewinds and truncates first, so it replaces the entire
    # file rather than appending. Call close when done; further calls to read,
    # write, or close after that raise/return IOError.
    path: str
    read: call() str | IOError
    write: call(contents: str) | IOError
    close: call() | IOError
}

let print = fn(values...) {
    # Print any number of inspected values separated by single spaces to
    # stdout without a trailing newline, then return null. Values are rendered
    # the same way they would appear in an error message or template-string
    # interpolation, not necessarily as raw strings.
}

let println = fn(values...) {
    # Print values exactly like print, followed by one newline, then return
    # null. Calling println with no values prints one newline.
}

let open = fn(path: str) File | FileNotFound | PermissionDenied {
    # Open an existing file at path for both reading and writing. The file
    # is not created if missing: open returns FileNotFound instead. Any
    # other operating-system error opening the file (such as insufficient
    # permissions) returns PermissionDenied. The returned File must be
    # closed explicitly with File.close; consider a defer immediately after
    # a successful open.
}

let stdin: IOStream = IOStream{
    "stdin",
    fn() str | IOError {},
    fn() str | IOError {},
    fn(data: str) | IOError {}
}
let stdout: IOStream = IOStream{
    "stdout",
    fn() str | IOError {},
    fn() str | IOError {},
    fn(data: str) | IOError {}
}
let stderr: IOStream = IOStream{
    "stderr",
    fn() str | IOError {},
    fn() str | IOError {},
    fn(data: str) | IOError {}
}
