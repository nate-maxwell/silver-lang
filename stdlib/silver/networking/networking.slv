# Public networking API. The Silver wrapper provides a nominal protocol enum
# while the native module owns the underlying sockets.
let _native = import("_networking")

enum Network {
    TCP,
    UDP,
}

let dial = fn(network: Network, address: str) Connection | ConnectionError {
    if network == Network.TCP {
        return _native.dial_tcp(address)
    }
    return _native.dial_udp(address)
}

let listen = fn(address: str) Listener | ListenError {
    _native.listen(address)
}
