    open: call() File | FileNotFound | PermissionDenied
    read_bytes: call() str
    read_text: call() str
    readlink: call() Path
    relative_to: call(other: Path) Path
    rename: call(target: Path) Path
    replace: call(target: Path) Path
    resolve: call() Path
    rglob: call(pattern: str) array
    rmdir: call()
    samefile: call(other: Path) bool
    stat: call() map
    symlink_to: call(target: Path)
    touch: call()
    unlink: call()
    walk: call() array
    with_name: call(name: str) Path
    with_stem: call(stem: str) Path
    with_suffix: call(suffix: str) Path
    write_bytes: call(contents: str) int
    write_text: call(contents: str) int
}

