# Editor stub for import("networking").

enum Network {
    TCP,
    UDP,
}

struct ConnectionError {
    message: str
}

struct ListenError {
    message: str
}

struct ReadError {
    message: str
}

struct WriteError {
    message: str
}

struct ReadFromResult {
    data: str
    address: str
}

struct Connection {
    address: str
    read: call(bytes: int) str | ReadError
    write: call(data: str) | WriteError
    write_to: call(data: str, address: str) | WriteError
    read_from: call(bytes: int) ReadFromResult | ReadError
    close: call() | ConnectionError
}

struct Listener {
    address: str
    accept: call() Connection | ConnectionError
    close: call() | ConnectionError
}

