# Editor stub for import("math").
#
# Numeric helpers beyond the built-in arithmetic operators. Functions that
# take a single numeric argument accept either int or float unless noted;
# trigonometric and exponential functions always return float, even for an
# integer input.

let pi: float = 0.0
let e: float = 0.0
let tau: float = 0.0
let nan: float = 0.0

let factorial = fn(value: int) int {
    # Return a nonnegative integer's factorial (value!). Negative input, or a
    # result that overflows signed 64-bit range, raises ValueError.
}

let gcd = fn(values: array) int {
    # Return the greatest common divisor of every integer in values,
    # regardless of sign. The identity for an empty array is 0; gcd of a
    # single-element array is that element's absolute value.
}

let lcm = fn(values: array) int {
    # Return the least common multiple of every integer in values. The
    # identity for an empty array is 1; if any element is 0 the result is 0.
    # Raises ValueError if the true result would overflow signed 64-bit
    # range.
}

let lcd = fn(values: array) int {
    # Compatibility alias for lcm (least common multiple, despite the name).
}

let isqrt = fn(value: int) int {
    # Return the floor of the square root of a nonnegative integer, computed
    # exactly with no floating-point rounding error. Negative input raises
    # ValueError.
}

let abs = fn(value) {
    # Return the absolute value of an int or float while preserving its
    # numeric type. Taking the absolute value of the minimum representable
    # int (which has no positive counterpart) raises ValueError.
}

let ceil = fn(value) int {
    # Round an int or float upward to the nearest integer; an int argument is
    # returned unchanged. Raises ValueError if the mathematical result does
    # not fit in a 64-bit int (for example ceil(nan) or an extreme float).
}

let floor = fn(value) int {
    # Round an int or float downward to the nearest integer; an int argument
    # is returned unchanged. Raises ValueError under the same out-of-range
    # conditions as ceil.
}

let trunc = fn(value) int {
    # Truncate an int or float toward zero; an int argument is returned
    # unchanged. Raises ValueError under the same out-of-range conditions as
    # ceil.
}

let truc = fn(value) int {
    # Compatibility alias for trunc.
}

let fmod = fn(left, right) float {
    # Return the floating-point remainder of left / right whose quotient is
    # truncated toward zero, matching C's fmod (the sign of the result
    # follows left).
}

let remainder = fn(left, right) float {
    # Return the IEEE-754 remainder of left / right, using the quotient
    # rounded to the nearest integer (ties to even) rather than truncated,
    # so the result can differ in sign and magnitude from fmod.
}

let remainer = fn(left, right) float {
    # Compatibility alias for remainder.
}

let modf = fn(value) array {
    # Split value into its fractional and integer parts, both as float, and
    # return them as [fractional_part, integer_part]; both parts share
    # value's sign.
}

let acos = fn(value) float {
    # Return the arc cosine of value in radians. value must be in [-1, 1];
    # outside that range the result is NaN, matching IEEE-754 float
    # behavior rather than raising.
}

let asin = fn(value) float {
    # Return the arc sine of value in radians, with the same domain and NaN
    # behavior as acos.
}

let atan = fn(value) float {
    # Return the arc tangent of value in radians, in the range
    # (-pi/2, pi/2).
}

let cos = fn(value) float {
    # Return the cosine of a radian angle.
}

let sin = fn(value) float {
    # Return the sine of a radian angle.
}

let tan = fn(value) float {
    # Return the tangent of a radian angle.
}

let cbrt = fn(value) float {
    # Return the cube root of value, including for negative value (unlike
    # sqrt, which only accepts nonnegative input meaningfully).
}

let sqrt = fn(value) float {
    # Return the square root of value. A negative value produces NaN rather
    # than raising.
}

let exp = fn(value) float {
    # Return e raised to the power value.
}

let exp2 = fn(value) float {
    # Return 2 raised to the power value.
}

let expm1 = fn(value) float {
    # Return e raised to the power value, minus 1, computed accurately even
    # when value is close to 0 (where exp(value) - 1 would lose precision).
}

let log = fn(value, base) float {
    # Return the logarithm of value in the supplied base, computed as
    # ln(value) / ln(base).
}

let log1p = fn(value) float {
    # Return the natural logarithm of 1 + value, computed accurately even
    # when value is close to 0.
}

let log2 = fn(value) float {
    # Return the base-2 logarithm of value.
}

let log10 = fn(value) float {
    # Return the base-10 logarithm of value.
}

let degrees = fn(radians) float {
    # Convert an angle in radians to degrees.
}

let radians = fn(degrees) float {
    # Convert an angle in degrees to radians.
}

let min = fn(left, right) {
    # Return whichever of left and right is smaller, returned as the
    # original operand so its int/float type is preserved. Mixed int and
    # float inputs compare by numeric value; if the two are equal, left is
    # returned.
}

let max = fn(left, right) {
    # Return whichever of left and right is larger, returned as the original
    # operand so its int/float type is preserved. Mixed int and float inputs
    # compare by numeric value; if the two are equal, left is returned.
}
