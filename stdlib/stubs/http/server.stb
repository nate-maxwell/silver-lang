# Editor stub for import("http/server").
#
# The server accepts HTTP/1.1 requests over a blocking TCP listener. It handles
# one request per connection, normalizes incoming header names to lowercase,
# and closes the connection after writing a Content-Length response.

struct Request {
    method: str
    path: str
    version: str
    headers: map
    body: str
    remote_address: str
}

struct Response {
    status_code: int
    reason: str
    headers: map
    body: str
}

struct ServerError {
    # ServerError reports malformed HTTP input or a socket failure while
    # accepting, reading, or writing a request.
    message: str
}

struct Server {
    address: str
    listener: Listener
    handler: call(self: Server, request: Request) Response
    serve_once: call(self: Server) | ServerError
    serve: call(self: Server) | ServerError
    close: call(self: Server) | ConnectionError
}

