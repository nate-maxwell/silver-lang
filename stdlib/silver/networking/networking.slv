# Public networking API. The package supplies socket functions and types from
# Go; this entry file adds the protocol enum and the generic dial function.
export {
    Network,
    dial,
    dial_tcp,
    dial_udp,
    listen,
    Connection,
    Listener,
    ReadFromResult,
    ConnectionError,
    ListenError,
    ReadError,
    WriteError,
}

type Network = enum {
    TCP,
    UDP,
}

let dial = fn(network: Network, address: str) Connection | ConnectionError {
    if network == Network.TCP {
        return dial_tcp(address)
    }
    return dial_udp(address)
}
