# Editor stub for import("path").
#

struct Path {
    # A pathlib-style wrapper around a single filesystem path string, modeled on
    # Python's pathlib.Path. Every Path is immutable: methods that describe a
    # different path (parent, joinpath, with_name, resolve, and so on) return a
    # new Path rather than mutating the receiver. Methods that touch the
    # filesystem (exists, stat, read_text, mkdir, unlink, and so on) run
    # eagerly, synchronously, and can fail with the same IOError family as
    # io.open; check exists() first when a missing path should not be an error.
    # path.path is always filepath.Clean-normalized to the host's native
    # separator, so components can differ in exact spelling from what was
    # originally passed to new.
    path: str
    anchor: str
    drive: str
    name: str
    parts: array
    root: str
    stem: str
    suffix: str
    suffixes: array
    parent: call() Path
    parents: call() array
    absolute: call() Path | ValueError
    as_posix: call() str
    as_uri: call() str | ValueError
    chmod: call(mode: int) | ValueError
    exists: call() bool
    expanduser: call() Path | ValueError
    glob: call(pattern: str) array | ValueError
    hardlink_to: call(target: any) | TypeError | ValueError
    is_absolute: call() bool
    is_block_device: call() bool
    is_char_device: call() bool
    is_dir: call() bool
    is_fifo: call() bool
    is_file: call() bool
    is_mount: call() bool
    is_relative_to: call(other: any) bool | TypeError
    is_socket: call() bool
    is_symlink: call() bool
    iterdir: call() array | ValueError
    joinpath: call(parts: any...) Path | TypeError
    lstat: call() map | ValueError
    match: call(pattern: str) bool | ValueError
    mkdir: call(options: any...) | TypeError | ValueError
    open: call() File | FileNotFound | PermissionDenied
    read_bytes: call() str | ValueError
    read_text: call() str | ValueError
    readlink: call() Path | ValueError
    relative_to: call(other: any) Path | TypeError | ValueError
    rename: call(target: any) Path | TypeError | ValueError
    replace: call(target: any) Path | TypeError | ValueError
    resolve: call() Path | ValueError
    rglob: call(pattern: str) array | ValueError
    rmdir: call() | ValueError
    samefile: call(other: any) bool | TypeError | ValueError
    stat: call() map | ValueError
    symlink_to: call(target: any) | TypeError | ValueError
    touch: call(options: any...) | TypeError | ValueError
    unlink: call(options: any...) | TypeError | ValueError
    walk: call() array | ValueError
    with_name: call(name: str) Path | ValueError
    with_stem: call(stem: str) Path | ValueError
    with_suffix: call(suffix: str) Path | ValueError
    write_bytes: call(contents: str) int | ValueError
    write_text: call(contents: str) int | ValueError
}

let new = fn(path: any) Path | TypeError {
    # Clean and wrap a platform-native path string: redundant separators and
    # "." segments are removed, but the path is not resolved against the
    # filesystem or made absolute (use resolve or absolute for that). Does
    # not touch the filesystem, so path need not exist.
}

let cwd = fn() Path | ValueError {
    # Return the current working directory as a Path, as reported by the
    # operating system at the moment of the call.
}

let home = fn() Path | ValueError {
    # Return the current user's home directory as a Path.
}
