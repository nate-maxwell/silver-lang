# Editor stub for import("string").
#
# String helpers beyond the built-in + operator and indexing. Positions and
# counts (find, rfind, count, len from "core") are UTF-8 byte offsets, not
# Unicode code point counts; use chars to work code-point-by-code-point on
# non-ASCII text. Every function here returns a new string; none mutate
# their arguments, since Silver strings are immutable.

let codepoint = fn(value: str) int | ValueError {
    # Return the Unicode code point of a string containing exactly one
    # character.
}

let from_codepoint = fn(value: int) str | ValueError {
    # Return the character represented by a valid Unicode scalar value.
}

let utf8_bytes = fn(value: str) array {
    # Return value's UTF-8 encoding as an array of integer bytes.
}

let to_int = fn(value: str) int | ValueError {
    # Parse a signed base-10 integer, e.g. "-42" or "7". Surrounding
    # whitespace, non-numeric text, and values outside the signed 64-bit
    # range all raise ValueError; there is no automatic trimming.
}

let from_int = fn(value: int) str {
    # Format value in base 10, e.g. 42 becomes "42".
}

let to_float = fn(value: str) float | ValueError {
    # Parse value as a 64-bit floating-point number, e.g. "3.14" or "1e10".
    # Raises ValueError for malformed input; whitespace is not trimmed.
}

let from_float = fn(value: float) str {
    # Format value using Silver's compact floating-point display form (the
    # shortest decimal representation that round-trips back to value).
}

let to_bool = fn(value: str) bool | ValueError {
    # Parse "true" or "false", matched case-insensitively (so "True" and
    # "FALSE" are also accepted). Raises ValueError for anything else;
    # whitespace is not trimmed.
}

let from_bool = fn(value: bool) str {
    # Format value as the literal string "true" or "false".
}

let capitalize = fn(value: str) str {
    # Uppercase only the first Unicode code point of value and lowercase
    # every other code point, e.g. "HELLO world" becomes "Hello world".
}

let lower = fn(value: str) str {
    # Convert every cased Unicode letter in value to lowercase.
}

let upper = fn(value: str) str {
    # Convert every cased Unicode letter in value to uppercase.
}

let swapcase = fn(value: str) str {
    # Swap the case of every cased Unicode letter in value: uppercase
    # letters become lowercase and vice versa.
}

let title = fn(value: str) str {
    # Return value with the first letter of each word uppercased and the
    # rest of each word lowercased, using Unicode word boundaries.
}

let strip = fn(value: str) str {
    # Remove leading and trailing runs of Unicode whitespace from value.
}

let lstrip = fn(value: str) str {
    # Remove only leading Unicode whitespace from value.
}

let rstrip = fn(value: str) str {
    # Remove only trailing Unicode whitespace from value.
}

let removeprefix = fn(value: str, prefix: str) str {
    # Return value without a single leading occurrence of prefix. Returns
    # value unchanged when it does not start with prefix.
}

let removesuffix = fn(value: str, suffix: str) str {
    # Return value without a single trailing occurrence of suffix. Returns
    # value unchanged when it does not end with suffix.
}

let replace = fn(value: str, old: str, new: str) str {
    # Replace every non-overlapping occurrence of old in value with new.
    # Passing an empty old inserts new between every code point (and at
    # both ends), matching Go's strings.ReplaceAll.
}

let repeat = fn(value: str, count: int) str {
    # Return value repeated count times back to back. count must be
    # nonnegative; count of 0 or an empty value produces "". Raises
    # ValueError if the result would exceed 1,000,000 bytes.
}

let reverse = fn(value: str) str {
    # Reverse value by Unicode code point (not by byte), so multi-byte
    # characters remain intact rather than being scrambled.
}

let chars = fn(value: str) array {
    # Split value into an array of one-code-point strings, decoding UTF-8
    # correctly. Use len(string.chars(value)) to count code points instead
    # of core.len's byte count.
}

let fields = fn(value: str) array {
    # Split value around one or more runs of Unicode whitespace, discarding
    # empty leading/trailing fields (similar to Python's str.split() with no
    # arguments).
}

let split = fn(value: str, separator: str) array {
    # Split value on every occurrence of a nonempty separator. Passing an
    # empty separator raises ValueError; use chars to split into individual
    # code points instead.
}

let splitlines = fn(value: str) array {
    # Split value into lines, treating LF, CRLF, and lone CR as line
    # terminators. A trailing terminator does not produce a final empty
    # string element; an empty value produces an empty array.
}

let join = fn(values: array, separator: str) str {
    # Join an array containing only strings, with separator inserted
    # between (but not before or after) each element. Any non-string
    # element is a runtime type error.
}

let compare = fn(left: str, right: str) int {
    # Return -1 if left sorts before right, 0 if they are equal, or 1 if
    # left sorts after right, using byte-wise lexical ordering.
}

let contains = fn(value: str, substring: str) bool {
    # Report whether substring occurs anywhere in value. Every string
    # contains the empty string.
}

let count = fn(value: str, substring: str) int {
    # Return the number of non-overlapping occurrences of substring in
    # value.
}

let find = fn(value: str, substring: str) int {
    # Return the UTF-8 byte index of the first occurrence of substring, or
    # -1 when it does not occur in value.
}

let rfind = fn(value: str, substring: str) int {
    # Return the UTF-8 byte index of the last occurrence of substring, or -1
    # when it does not occur in value.
}

let startswith = fn(value: str, prefix: str) bool {
    # Report whether value begins with prefix exactly (case-sensitive).
}

let endswith = fn(value: str, suffix: str) bool {
    # Report whether value ends with suffix exactly (case-sensitive).
}

let equal_fold = fn(left: str, right: str) bool {
    # Compare left and right for equality under Unicode simple case
    # folding, a case-insensitive comparison that is more correct across
    # scripts than lower(left) == lower(right).
}

let isalnum = fn(value: str) bool {
    # Report whether value is nonempty and every code point is a Unicode
    # letter or number.
}

let isalpha = fn(value: str) bool {
    # Report whether value is nonempty and every code point is a Unicode
    # letter.
}

let isascii = fn(value: str) bool {
    # Report whether every byte in value is in the ASCII range (0-127).
    # Empty input is true.
}

let isdecimal = fn(value: str) bool {
    # Report whether value is nonempty and every code point is a Unicode
    # decimal digit.
}

let isdigit = fn(value: str) bool {
    # Report whether value is nonempty and every code point is a Unicode
    # digit (a slightly broader category than isdecimal, e.g. superscripts).
}

let islower = fn(value: str) bool {
    # Report whether value contains at least one cased letter and every
    # cased letter in it is lowercase.
}

let isnumeric = fn(value: str) bool {
    # Report whether value is nonempty and every code point is a Unicode
    # numeric character (a broader category than isdigit, e.g. fractions
    # and numerals from other scripts).
}

let isprintable = fn(value: str) bool {
    # Report whether every code point in value is printable (not a control
    # character). Empty input is true.
}

let isspace = fn(value: str) bool {
    # Report whether value is nonempty and every code point is Unicode
    # whitespace.
}

let istitle = fn(value: str) bool {
    # Report whether value contains at least one cased letter and its cased
    # letters follow Unicode title-case word form (first letter of each word
    # uppercase, the rest lowercase).
}

let isupper = fn(value: str) bool {
    # Report whether value contains at least one cased letter and every
    # cased letter in it is uppercase.
}
