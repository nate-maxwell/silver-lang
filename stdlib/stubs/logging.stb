# Editor stub for import("logging").
#
# A small structured-logging layer implemented in Silver on top of io, path,
# networking, and time. A Logger renders each message through a lazy
# TemplateString format and forwards the rendered record to one handler,
# which is responsible for actually delivering it (to a stream, a file, or a
# socket). Logger.level and Level exist for callers to label and branch on
# severity; new_logger does not filter records by level itself.

let pathlib = import("path")

# Level names the severity of a log record, from least to most severe.
# Nothing in this module compares levels automatically; use it to label
# loggers and records, and filter in the format function or handler if
# needed.
enum Level {
    Debug,
    Info,
    Warning,
    Error,
    Critical,
}

# StreamHandler writes each record and a trailing newline to an io.IOStream
# (for example io.stdout or io.stderr) via IOStream.write.
struct StreamHandler {
    stream: IOStream
    handle: call(self: StreamHandler, record: str) | IOError
}

# FileHandler appends each record and a trailing newline to a file at path,
# creating it if needed. Each call reads the file's full current contents,
# concatenates the new record, and writes the whole file back, so very large
# log files make this progressively more expensive.
struct FileHandler {
    path: pathlib.Path
    handle: call(self: FileHandler, record: str)
}

# RotatingFileHandler behaves like FileHandler, except that once at least
# interval seconds have passed since the last rotation (or since creation)
# and the file exists, it is first renamed to its own path suffixed with a
# timestamp before the new record is appended to a fresh file.
struct RotatingFileHandler {
    path: pathlib.Path
    interval: int
    last_rotation: int
    handle: call(self: RotatingFileHandler, record: str)
}

# TCPSocketHandler dials a new TCP connection to address for every record,
# writes the record plus a trailing newline, and closes the connection
# immediately afterward.
struct TCPSocketHandler {
    address: str
    handle: call(self: TCPSocketHandler, record: str) | ConnectionError | WriteError
}

# UDPSocketHandler dials a new UDP connection to address for every record,
# writes the record plus a trailing newline, and closes the connection
# immediately afterward. Like any UDP send, delivery is not guaranteed.
struct UDPSocketHandler {
    address: str
    handle: call(self: UDPSocketHandler, record: str) | ConnectionError | WriteError
}

# NullHandler discards every record; useful as a default handler in tests or
# libraries that should not produce output on their own.
struct NullHandler {
    handle: call(self: NullHandler, record: str)
}

# Logger is the value applications call handle on to emit one record. format
# is the already-rendered TemplateString captured by new_logger; each call
# to handle re-evaluates it with the current message and time.
struct Logger {
    level: Level
    format: TemplateString
    handle: call(self: Logger, message: str)
}

# LogContext is passed to a format function each time new_logger builds a
# logger's TemplateString, and is mutated with the current time and message
# before every subsequent handle call. time is formatted as "YYYY-MM-DD
# HH:mm:ss".
struct LogContext {
    level: Level
    time: str
    message: str
}

let standard_format = fn(context: LogContext) TemplateString {
    # Return the default lazy format: [{level}] {time} {message}. Pass this
    # directly to new_logger, or use it as a template for a custom format
    # function with a different layout.
}

let new_logger = fn(
    level: Level,
    format: call(context: LogContext) TemplateString,
    handler
) Logger {
    # Create a logger whose handle method renders the lazy format and sends
    # the record to handler. format is called once, up front, with an empty
    # LogContext to capture the TemplateString; each later handle call
    # updates that same context's time and message before re-evaluating the
    # template and forwarding the rendered string to handler.handle.
    # Logger.level labels records but does not filter them; combine with
    # your own conditional handle calls if you need level-based filtering.
}

let new_stream_handler = fn(stream: IOStream) StreamHandler {
    # Create a handler that writes each record and a newline to stream (for
    # example io.stdout or io.stderr).
}

let new_file_handler = fn(path: pathlib.Path) FileHandler {
    # Create a handler that appends by reading and rewriting the complete
    # file at path, creating it on the first write if it does not exist.
}

let new_rotating_file_handler = fn(
    path: pathlib.Path,
    interval: int
) RotatingFileHandler {
    # Create a file handler that rotates after interval Unix seconds have
