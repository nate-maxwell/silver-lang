}

let new_udp_socket_handler = fn(address: str) UDPSocketHandler {
    # Create a handler that opens a UDP connection to address for each
    # record, writes the record, and closes the connection.
}

let new_null_handler = fn() NullHandler {
    # Create a handler that discards every record.
}
