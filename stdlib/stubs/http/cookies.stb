# Cookie and Set-Cookie parsing and serialization. Cookie attributes use
# empty strings, zero, or False when they were not supplied.

enum SameSite {
    Default,
    Lax,
    Strict,
    None,
}

struct Cookie {
    name: str
    value: str
    path: str
    domain: str
    expires: str
    max_age: int
    secure: bool
    http_only: bool
    same_site: SameSite
}

struct CookieError {
    # CookieError reports a malformed name, value, pair, or Max-Age value.
    message: str
}

