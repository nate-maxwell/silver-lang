# Editor stub for import("args").

enum ArgumentKind {
    Option,
    Flag,
    Count,
    Positional,
}

struct Argument {
    name: str
    short: str
    help: str
    kind: ArgumentKind
    required: bool
    default_value: str
    has_default: bool
}

struct ArgumentError {
    message: str
}

struct ParsedArgs {
    values: map
    help_requested: bool
}

struct Parser {
    program: str
    description: str
    arguments: array
    add: call(self: Parser, argument: Argument) | ArgumentError
    parse: call(self: Parser, argv: array) ParsedArgs | ArgumentError
    help: call(self: Parser) str
}

