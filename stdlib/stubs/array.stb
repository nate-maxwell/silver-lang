# Editor stub for import("array").
#
# Pure array helpers. Every function here returns a new array (or element)
# and leaves its input untouched; there is no in-place mutation, so results
# must be captured with a let binding or returned to be visible.

let of = fn(values...) array {
    # Collect all supplied values into a new array. Calling of() returns an
    # empty array.
}

let append = fn(values: array, value) array {
    # Return a copy of values with value added at the end. The original
    # array is not mutated, so chained calls like append(append(a, x), y)
    # are required to accumulate more than one value.
}

let contains = fn(values: array, value) bool {
    # Report whether values contains an element equal to value. Numeric
    # comparison accepts mixed int and float values (1 and 1.0 compare
    # equal); strings and booleans compare by exact value.
}

let first = fn(values: array) {
    # Return the first element, or null when values is empty. Equivalent to
    # values[0] except that it does not raise for an empty array.
}

let last = fn(values: array) {
    # Return the last element, or null when values is empty. Equivalent to
    # values[len(values) - 1] except that it does not raise for an empty
    # array.
}

let remove = fn(values: array, index: int) {
    # Return a copy without the indexed element, or null when index is
    # negative or greater than or equal to len(values). Elements after index
    # shift left by one position in the result; values itself is unchanged.
}

let rest = fn(values: array) {
    # Return a copy without the first element, or null when values is empty.
    # Combined with first, this lets an array be consumed head-first without
    # index arithmetic.
}

let reverse = fn(values: array) array {
    # Return a reversed copy of values; the original array keeps its order.
}

let sort = fn(values: array) array {
    # Return a stable ascending copy of an all-numeric or all-string array.
    # Integers and floats may be mixed and compare by numeric value; sorting
    # any other mix of types, or an array holding anything other than
    # numbers or strings, is a runtime type error. Equal elements keep their
    # relative order from values.
}
